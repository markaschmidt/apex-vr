{
  "name": "@apex-vr/agents",
  "version": "0.1.0",
  "description": "Standardized VR AI-agent primitives: state machine, avatar runtime, spatial intent bus.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
